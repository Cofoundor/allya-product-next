# Where the product API lives. Start it with:
#   uvicorn main:app --reload --port 8000   (from ../product-api)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Where the LinkedIn publishing backend lives — a different service from the
# one above, and an origin with no path (its routers are mounted at the root).
# Leave it empty and /marketing/linkedin says it isn't wired up rather than
# pretending: nothing in that pane is invented.
#
# That backend authenticates with an `access_token` cookie it sets itself, so
# for a cross-origin deploy it must also send SameSite=None; Secure and list
# this app's origin in its CORS allow_origins.
NEXT_PUBLIC_LINKEDIN_API_URL=
